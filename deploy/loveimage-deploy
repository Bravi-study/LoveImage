#!/bin/sh
# Template for /usr/local/bin/loveimage-deploy on the server. The only thing the deploy key may run.
set -e
cd /opt/loveimage
git fetch -q origin main
# The repo tracks .env with public keys, the server's copy has its own keys and the only DB_PASSWORD: a reset must not replace it.
# An .env.keep left by a crash is the server's copy, so it is never overwritten.
[ -e .env.keep ] || cp -p .env .env.keep
git reset -q --hard FETCH_HEAD
mv .env.keep .env
git clean -fdq -e .env
git log -1 --format='Deploying %h %s'
# Only these two: a bare "up -d" would start Caddy and open ports 80 and 443 before the site is ready.
docker compose up -d --build app worker
curl -fsS --retry 30 --retry-all-errors --retry-delay 2 -o /dev/null http://127.0.0.1:8000/
restarts() { docker inspect -f '{{.RestartCount}}' $(docker compose ps -q app worker); }
before=$(restarts)
sleep 10
if [ "$(restarts)" != "$before" ]; then
  echo 'app or worker keeps restarting' >&2
  exit 1
fi
docker compose ps app worker
