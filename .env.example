KIE_AI_API_KEY=
COMMANDCODE_API_KEY=

KIE_MODEL=gpt-image-2-5-flare-image-to-image
# 1K 6 credits, 2K 10, 4K 16. One credit is $0.005.
KIE_RESOLUTION=2K
LLM_MODEL=deepseek/deepseek-v4.1-flash-fast
# Photos per day across the whole site: this is the cap on spending.
DAILY_GENERATION_LIMIT=30
PERSONAL_DAILY_LIMIT=6
UPLOADS_PER_IP=30
IMAGES_PER_IP=12

DATABASE_URL=postgresql://localhost/loveimage
DATA_DIR=data

KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_URL=https://kieai.redpandaai.co
LLM_BASE_URL=https://api.commandcode.ai/provider/v1

# The site's domain, A records for it and for www must point at the server. Empty means localhost.
DOMAIN=

# The database password for compose, letters and digits only. Empty means the local default, set one on a server.
DB_PASSWORD=
