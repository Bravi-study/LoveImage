{
  "name": "loveimage-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/*.test.ts",
    "gen:api": "cd .. && uv run --env-file .env.fake python -c \"import json; from loveimage.api import create_app; print(json.dumps(create_app().openapi()))\" > web/openapi.json && cd web && openapi-typescript openapi.json -o src/api-types.ts && rm openapi.json"
  },
  "dependencies": {
    "@fontsource-variable/cormorant": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
